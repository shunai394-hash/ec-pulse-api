# Application
APP_ENV=development
APP_BASE_URL=http://localhost:8000
# Public canonical URL for sitemap/social metadata; leave blank until the production alias is verified.
# Set only to the verified HTTPS Production domain; blank omits canonical/sitemap URLs.
PUBLIC_SITE_URL=
# Comma-separated exact origins allowed to call the API from browsers; blank disables CORS.
EC_PULSE_CORS_ORIGINS=
# Set true only after prices, credit quotas, and required legal disclosures are finalized.
EC_PULSE_LEGAL_READY=false

# Bootstrap/admin key (also accepted as an API key). Use a long random value.
# Set to the confirmed API base URL for scripts and the Claude MCP adapter.
EC_PULSE_API_BASE_URL=
EC_PULSE_API_KEY=
# Require HMAC request signatures on every API request (true/false)
EC_PULSE_REQUIRE_REQUEST_SIGNATURE=

# PostgreSQL connection string for monitor persistence
DATABASE_URL=

# Secret used by the scheduled monitor checker
CRON_SECRET=

# Stripe billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
STRIPE_PRO_PRICE_ID=
STRIPE_BUSINESS_PRICE_ID=

# Monthly credit quotas. Pro/Business: balance is topped up to this value once per paid
# Stripe invoice (no grant when blank). Also used for usage alerts.
EC_PULSE_FREE_MONTHLY_CREDITS=100
EC_PULSE_PRO_MONTHLY_CREDITS=
EC_PULSE_BUSINESS_MONTHLY_CREDITS=

# Official marketplace search APIs. Unofficial HTML scraping is disabled by default.
# Enable only after reviewing each source's terms, permissions, and retention rules.
EC_PULSE_ENABLE_UNOFFICIAL_HTML_SCRAPING=false
AMAZON_CLIENT_ID=
AMAZON_CLIENT_SECRET=
AMAZON_PARTNER_TAG=
AMAZON_CREDENTIAL_VERSION=3.3
YAHOO_SHOPPING_APP_ID=
RAKUTEN_APPLICATION_ID=
RAKUTEN_ACCESS_KEY=

# Supabase Auth / Google Login
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Patrol (optional)
PATROL_REPORT_WEBHOOK_URL=
PATROL_AI_API_KEY=
PATROL_AI_API_URL=
PATROL_AI_MODEL=
GROQ_API_KEY=
GROQ_API_URL=
OPENAI_API_KEY=
OPENAI_API_URL=
